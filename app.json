{
  "expo": {
    "name": "Nhom4 - Phân loại rác thông minh",
    "slug": "nhom4-smart-waste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/withAndroidFixes.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Nhom4 cần quyền camera để chụp ảnh và nhận diện rác.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nhom4 cần truy cập ảnh để bạn chọn ảnh rác cần phân loại.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nhom4 dùng vị trí khi ứng dụng mở để tìm điểm thu gom rác gần bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#13865A"
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": false
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA_EcoBin_Nhom4_MapKey_2026_SmartWaste"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E7F5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nhom4.ecobin",
      "versionCode": 2,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "nhom4",
    "extra": {
      "eas": {
        "projectId": "b444cc44-283c-4225-bec9-4f46c443addd"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b444cc44-283c-4225-bec9-4f46c443addd"
    }
  }
}
