# SQL Server connection
DB_USER=your_sql_user
DB_PASSWORD=change_this_password
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SmartTrashDB
DB_ENCRYPT=false
DB_TRUST_CERT=true
PORT=3000

